{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tombee Action Script",
  "scopeName": "source.tas",
  "fileTypes": [
    "tas"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#event-declarations"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tas",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tas",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tas",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tas",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.tas",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tas",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tas",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.tas",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.tas",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tas",
          "match": "\\b(if|else|while|for|in|return|break|continue|yield|await|async|interrupt|parallel|every|after|cancel|loop)\\b"
        },
        {
          "name": "constant.language.tas",
          "match": "\\b(true|false|null|inf|default)\\b"
        },
        {
          "name": "storage.type.tas",
          "match": "\\b(let|var|const|action|fn|func|event)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tas",
          "match": "\\b(wait|move_to|move_by|rotate_to|rotate_by|scale_to|scale_by|fade_to|fade_in|fade_out|play_sound|play_anim|stop_anim|spawn|destroy|log|print|kill|emit)\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(action|fn|func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.tas"
            },
            "2": {
              "name": "entity.name.function.tas"
            }
          }
        }
      ]
    },
    "event-declarations": {
      "patterns": [
        {
          "match": "\\b(event|on)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.event.tas"
            },
            "2": {
              "name": "entity.name.type.event.tas"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.tas"
            }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.tas",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.tas",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.tas",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.tas",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arrow.tas",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.arithmetic.tas",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.property.tas",
          "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.other.readwrite.tas",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
